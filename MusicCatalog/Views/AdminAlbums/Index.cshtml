                @Html.DisplayFor(modelItem => item.strLabel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.strReleaseFormat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.strAlbumThumb)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.strDescriptionEN)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idAlbum">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.idAlbum">Details</a> |
