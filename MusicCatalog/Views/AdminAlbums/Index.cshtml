                @Html.DisplayNameFor(model => model.strLabel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.strReleaseFormat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.strAlbumThumb)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.strDescriptionEN)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
